# Optional.
# Leave empty in normal Expo development so the app can auto-detect your local host.
# Use a value only when you want to force a specific API URL.

EXPO_PUBLIC_API_BASE_URL=

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# iOS simulator or mobile web:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Real phone on the same Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:3001

# Production builds use the deployed API URL from src/config/app.config.ts.
