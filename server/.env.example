# Copy this file to .env.local and fill in the values.

# ─── App ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=https://your-client-domain.netlify.app
SERVER_URL=https://your-server-domain.netlify.app

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Cloudflare R2 object storage ────────────────────────────────────────────
# Find your Account ID at: dash.cloudflare.com → R2 → Overview (right sidebar)
R2_ACCOUNT_ID=your_cloudflare_account_id

# The name of the bucket you created in the R2 dashboard
R2_BUCKET_NAME=fitlife-media

# Generate an API token at: R2 → Manage R2 API Tokens → Create API Token
# Grant "Object Read & Write" on this bucket only.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public base URL for serving uploaded files.
# Option 1 — free r2.dev subdomain (enable "Public access" in the bucket settings):
#   https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Option 2 — custom domain (add a custom domain in the bucket settings):
#   https://media.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─── EmailJS (password-reset emails) ─────────────────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_ACCESS_TOKEN=your_emailjs_access_token

CONTACT_EMAILJS_SERVICE_ID=service_xxxxxxx
CONTACT_EMAILJS_TEMPLATE_ID=template_xxxxxxx
CONTACT_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
CONTACT_EMAILJS_ACCESS_TOKEN=your_emailjs_access_token
CONTACT_TO_EMAIL=your@email.com
